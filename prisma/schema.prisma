// Prisma schema（学習用）。
// URL は prisma7.config.ts / アプリ側 env で渡す（schema 内に直書きしない）。
// https://pris.ly/d/prisma-schema

generator client {
  // 生成物は gitignore（src/generated/prisma）
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 学習用の最小モデル（接続確認・CRUD の土台）
model Note {
  id        String   @id @default(cuid())
  title     String
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
