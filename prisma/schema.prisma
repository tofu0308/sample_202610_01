// Prisma schema（学習用）。
// URL は prisma7.config.ts / アプリ側 env で渡す（schema 内に直書きしない）。
// https://pris.ly/d/prisma-schema

generator client {
  // 生成物は gitignore（src/generated/prisma）
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// 学習用の最小モデル（接続確認・CRUD の土台）
model Note {
  id        String   @id @default(cuid())
  title     String
  body      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// 商品マスタ（JAN 一意）。Yahoo などから取った名前・画像の控え
model Product {
  id        String   @id @default(cuid())
  jan       String   @unique
  name      String
  brandName String?
  imageUrl  String?
  /// データの出典。いまは "yahoo_shopping"。手入力マスタはあとで "manual" 等を足す想定
  source    String
  /// Yahoo カテゴリの控え（取っていないときは null）
  genreId   String?
  genreName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userItems UserItem[]
}

/// ユーザーが登録した 1 件。メモ・ステータス・残量など「状態」はこちら
model UserItem {
  id        String  @id @default(cuid())
  /// 誰の登録か。いまはサーバ定数。ログイン導入後は Auth のユーザー ID に差し替える
  userId    String
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  /// 用途の種類（例: paint）。画面の候補ラベル切り替え用。既定は paint
  presetKey String  @default("paint")
  remaining String?
  note      String?
  /// 予備のステータス欄（全部空でもよい）。画面ではまず status1 だけ使う想定
  status1   String?
  status2   String?
  status3   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId])
  @@index([userId])
  @@index([userId, presetKey])
}
