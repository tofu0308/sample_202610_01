# ローカル用の雛形（値は入れない／commit してよい）
# 実際の接続文字列は .env に書く（.env は gitignore）

# アプリ実行時（Supabase Transaction pooler / port 6543 想定）
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"

# Prisma CLI（migrate 等）。Session / Direct（port 5432 想定）
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Yahoo!ショッピング 商品検索（Client ID = アプリケーションID）
# 商品検索 v3 の appid に使う。サーバのみ。値は .env / Vercel に書く
YAHOO_APP_ID=""
# シークレットは ID 連携等向け。商品検索だけなら未使用でよい（必要なら .env にだけ置く）
# YAHOO_CLIENT_SECRET=""

# Supabase Auth（ブラウザにも載る公開値。秘密の service_role は置かない）
# URL は https://xxxx.supabase.co まで（/rest/v1 は付けない）
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
# 新しいダッシュボード表記ならこちらでも可（ANON が優先）
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""

# 管理者メール（将来の管理用途向け。いまはアプリ利用ゲートには使わない）
ADMIN_EMAIL=""
